<Window x:Class="Englishtest.SentencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="常用 1000 句練習" Height="700" Width="720"
        MinHeight="600" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        Closed="Window_Closed">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 頂部標題與狀態 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="常用 1000 句練習" FontSize="22" FontWeight="Bold" Foreground="#1A1A2E"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Border Background="#DBEAFE" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock x:Name="StatUnmaskedText" Text="循環中: 1000 句" FontSize="12" Foreground="#1E40AF" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2">
                        <TextBlock x:Name="StatMaskedText" Text="已學會遮罩: 0 句" FontSize="12" Foreground="#15803D" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ManageListButton" Content="📋 清單管理" Width="100" Height="32" Margin="0,0,8,0"
                        Click="ManageListButton_Click" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE"
                        FontWeight="SemiBold" Cursor="Hand"/>
                <Button x:Name="CloseButton" Content="返回" Width="70" Height="32"
                        Click="CloseButton_Click" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- 控制列與篩選 -->
        <Border Grid.Row="1" Margin="0,0,0,14" Padding="12" Background="White" CornerRadius="10"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="主題分類" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CategoryComboBox" Height="30" SelectionChanged="CategoryComboBox_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="抽題模式" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ModeRandomRadio" Content="🎲 隨機" IsChecked="True" Margin="0,0,8,0" Checked="ModeRadio_Checked"/>
                        <RadioButton x:Name="ModeSeqRadio" Content="🔢 依序" Checked="ModeRadio_Checked"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="遮罩英文" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                    <CheckBox x:Name="MaskEnCheckBox" Content="預設遮罩英文" IsChecked="True" Checked="MaskEnCheckBox_Changed" Unchecked="MaskEnCheckBox_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 句子主卡片 -->
        <Border Grid.Row="2" Margin="0,0,0,14" Padding="20" Background="White" CornerRadius="12"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#EEF2FF" CornerRadius="8" Padding="8,4">
                        <TextBlock x:Name="BadgeIdText" Text="#1 / 1000" FontSize="12" FontWeight="Bold" Foreground="#6366F1"/>
                    </Border>
                    <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="8" Padding="8,4">
                        <TextBlock x:Name="BadgeCatText" Text="日常問候" FontSize="12" Foreground="#64748B"/>
                    </Border>
                </Grid>

                <!-- 中文意思 -->
                <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="10" Padding="16,14" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <TextBlock x:Name="ZhText" Text="載入中…" FontSize="22" FontWeight="Bold" Foreground="#1E293B" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>

                <!-- 英文句子與遮罩 -->
                <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="10" Padding="16,14" Margin="0,0,0,14" BorderBrush="#CBD5E1" BorderThickness="2" Cursor="Hand" MouseLeftButtonDown="EnBox_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock x:Name="EnText" Text="" FontSize="20" FontWeight="SemiBold" Foreground="#2563EB" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="EnMaskOverlay" Background="#F8FAFC" CornerRadius="8" Visibility="Visible">
                            <TextBlock Text="👁️ 點擊此處揭曉英文" FontSize="16" FontWeight="Bold" Foreground="#6366F1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 操作按鈕 -->
                <Grid Grid.Row="3" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="PlayButton" Content="🔊 播放發音" Height="38" Click="PlayButton_Click" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" FontWeight="SemiBold"/>
                    <Button Grid.Column="2" x:Name="RevealButton" Content="👁️ 點擊揭曉英文" Height="38" Click="RevealButton_Click" Background="#F8FAFC" Foreground="#475569" BorderBrush="#CBD5E1" FontWeight="SemiBold"/>
                </Grid>

                <!-- 遮罩句子按鈕 (學會排除) -->
                <StackPanel Grid.Row="4">
                    <Button x:Name="MaskSentenceButton" Content="⚪ 標記已學會 (遮罩此句排除)" Height="40" Click="MaskSentenceButton_Click" Background="#FFFFFF" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1.5" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                    <TextBlock Text="💡 標記為「已學會」後，此句會被遮罩排除，不再進入隨機抽題循環名單。" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部導覽 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="PrevButton" Content="⬅️ 上一句" Height="44" Click="PrevButton_Click" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" FontWeight="SemiBold"/>
            <Button Grid.Column="2" x:Name="NextButton" Content="🎲 隨機下一句" Height="44" Click="NextButton_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="16" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>

<Window x:Class="Englishtest.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="英文單字測驗 — 首頁" Height="680" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F8">

    <Window.Resources>
        <!-- Card-style RadioButton that looks like a toggle button -->
        <Style x:Key="ToggleCardStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CardBorder" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5"
                                CornerRadius="8" Padding="8,8" Cursor="Hand" SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 測驗模式 -->
            <RowDefinition Height="Auto"/> <!-- 難度 (CEFR) -->
            <RowDefinition Height="Auto"/> <!-- 題數 -->
            <RowDefinition Height="Auto"/> <!-- 語音引擎 -->
            <RowDefinition Height="Auto"/> <!-- 開始挑戰按鈕 -->
            <RowDefinition Height="*"/>    <!-- 彈性間距 -->
            <RowDefinition Height="Auto"/> <!-- 其他學習工具卡片 -->
        </Grid.RowDefinitions>

        <!-- 1. 測驗模式 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="測驗模式" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="ModeTypingRadio" Grid.Column="0" GroupName="Mode" IsChecked="True"
                             Style="{StaticResource ToggleCardStyle}" Content="✏️  輸入作答" Tag="Typing"/>
                <RadioButton x:Name="ModeChoiceRadio" Grid.Column="2" GroupName="Mode"
                             Style="{StaticResource ToggleCardStyle}" Content="🔘  選擇題" Tag="Choice"/>
            </Grid>
        </StackPanel>

        <!-- 翻譯方向 (隱藏, 預留擴充) -->
        <StackPanel Visibility="Collapsed">
            <RadioButton x:Name="DirCtoERadio" GroupName="Direction" IsChecked="True" Tag="CtoE"/>
            <RadioButton x:Name="DirEtoCRadio" GroupName="Direction" Tag="EtoC"/>
        </StackPanel>

        <!-- 2. 難度卡片 (CEFR) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="難度等級 (CEFR)" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,8"/>
            <UniformGrid x:Name="LevelGrid" Columns="3" Rows="2" Margin="-2">
                <RadioButton x:Name="LevelA1Radio" GroupName="Level" Content="A1 初級" Style="{StaticResource ToggleCardStyle}" Margin="2" Click="LevelRadio_Click" Tag="A1"/>
                <RadioButton x:Name="LevelA2Radio" GroupName="Level" Content="A2 初中級" Style="{StaticResource ToggleCardStyle}" Margin="2" Click="LevelRadio_Click" Tag="A2"/>
                <RadioButton x:Name="LevelB1Radio" GroupName="Level" Content="B1 中級" Style="{StaticResource ToggleCardStyle}" Margin="2" Click="LevelRadio_Click" Tag="B1"/>
                <RadioButton x:Name="LevelB2Radio" GroupName="Level" Content="B2 中高級" Style="{StaticResource ToggleCardStyle}" Margin="2" Click="LevelRadio_Click" Tag="B2"/>
                <RadioButton x:Name="LevelC1Radio" GroupName="Level" Content="C1 高級" Style="{StaticResource ToggleCardStyle}" Margin="2" Click="LevelRadio_Click" Tag="C1"/>
                <RadioButton x:Name="LevelC2Radio" GroupName="Level" Content="C2 精通" Style="{StaticResource ToggleCardStyle}" Margin="2" Click="LevelRadio_Click" Tag="C2"/>
            </UniformGrid>
            <TextBlock x:Name="LevelPoolText" Text="載入中…" FontSize="12" Foreground="#64748B" Margin="0,6,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 3. 題數設定 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="挑戰單字數量" FontSize="14" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="5 題" Width="52" Height="26" Margin="2,0" Click="PresetCount_Click" Tag="5" Style="{StaticResource PresetBtnStyle}"/>
                    <Button Content="10 題" Width="52" Height="26" Margin="2,0" Click="PresetCount_Click" Tag="10" Style="{StaticResource PresetBtnStyle}"/>
                    <Button Content="20 題" Width="52" Height="26" Margin="2,0" Click="PresetCount_Click" Tag="20" Style="{StaticResource PresetBtnStyle}"/>
                    <Button Content="30 題" Width="52" Height="26" Margin="2,0" Click="PresetCount_Click" Tag="30" Style="{StaticResource PresetBtnStyle}"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="QuestionCountSlider" Grid.Column="0" Minimum="1" Maximum="30" Value="10"
                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        ValueChanged="QuestionCountSlider_ValueChanged"/>
                <TextBlock x:Name="QuestionCountText" Grid.Column="1" Text="10 題" FontSize="15" FontWeight="Bold"
                           Foreground="#2563EB" VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="48"/>
            </Grid>
        </StackPanel>

        <!-- 4. 語音引擎 (TTS) -->
        <StackPanel Grid.Row="3" Margin="0,0,0,20">
            <TextBlock Text="發音語音 (TTS)" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,8"/>
            <ComboBox x:Name="VoiceComboBox" Height="36" FontSize="14" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- 5. 主要按鈕: 開始挑戰 -->
        <Border Grid.Row="4" Margin="0,0,0,16">
            <Button x:Name="StartButton" Content="🚀 開始挑戰" Height="48" IsDefault="True"
                    Click="StartButton_Click"
                    Background="#2563EB" Foreground="White" FontSize="18" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Border>

        <!-- 6. 其他學習工具 (區隔獨立區塊，防誤觸) -->
        <Border Grid.Row="6" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12">
            <StackPanel>
                <TextBlock Text="💡 其他學習模式" FontSize="13" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SentencesButton" Grid.Column="0" Content="📚 常用1200句" Height="40"
                            Click="SentencesButton_Click"
                            Background="#F5F3FF" Foreground="#6D28D9" BorderBrush="#DDD6FE" BorderThickness="1"
                            FontWeight="Bold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="GuideReadingButton" Grid.Column="2" Content="📖 文章導讀" Height="40"
                            Click="GuideReadingButton_Click"
                            Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1"
                            FontWeight="Bold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
